# ---------------------------------------------------------------------------
# RELANCE — variables d'environnement
# Copier en .env.local (jamais commité). Les variables NEXT_PUBLIC_* sont
# exposées au navigateur : n'y mettez jamais de secret.
# ---------------------------------------------------------------------------

# URL publique de l'application (utilisée dans les liens des emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé "publishable" (sb_publishable_...) ou, pour les anciens projets, la clé "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_... / service_role) — serveur uniquement : journal d'usage IA, jobs, webhooks
SUPABASE_SECRET_KEY=

# Connexion Google : passer à true uniquement après configuration du fournisseur Google dans Supabase
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Phases suivantes (adaptateurs prévus, non encore branchés) -------------
# IA — utilisée dès la phase 2 pour l'extraction des CV (repli automatique sans IA si absente)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=45000
# Estimation des coûts (tableau d'administration) : € par million de jetons, d'après la grille du fournisseur
AI_PRICE_INPUT_EUR_PER_MTOK=0
AI_PRICE_OUTPUT_EUR_PER_MTOK=0
EMBEDDING_DIMENSIONS=1536
# Paiements Stripe — clés de test (sk_test_…) pour la recette. Les prix viennent de la table plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Emails transactionnels (phase 6)
RESEND_API_KEY=
EMAIL_FROM="Relance <notifications@example.fr>"
# Suivi des erreurs serveur (optionnel ; projet Sentry hébergé dans l'UE recommandé)
SENTRY_DSN=
# Tâche quotidienne /api/jobs/daily (suppressions de comptes, maintenance).
# Vercel Cron envoie automatiquement « Authorization: Bearer $CRON_SECRET ». 32 caractères aléatoires minimum.
CRON_SECRET=
