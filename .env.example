# ---------------------------------------------------------------------------
# RELANCE — variables d'environnement
# Copier en .env.local (jamais commité). Les variables NEXT_PUBLIC_* sont
# exposées au navigateur : n'y mettez jamais de secret.
# ---------------------------------------------------------------------------

# URL publique de l'application (utilisée dans les liens des emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé "publishable" (sb_publishable_...) ou, pour les anciens projets, la clé "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_... / service_role) — serveur uniquement, phases 2+ (jobs, webhooks)
SUPABASE_SECRET_KEY=

# Connexion Google : passer à true uniquement après configuration du fournisseur Google dans Supabase
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Phases suivantes (adaptateurs prévus, non encore branchés) -------------
# IA (phase 3)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EMBEDDING_DIMENSIONS=1536
# Paiements (phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Emails transactionnels (phase 6)
RESEND_API_KEY=
EMAIL_FROM="Relance <notifications@example.fr>"
# Monitoring (phase 8)
SENTRY_DSN=
# Jobs asynchrones (phase 2)
JOBS_RUNNER_SECRET=
